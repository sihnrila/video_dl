{
  "name": "chzzk-dl",
  "version": "1.0.0",
  "author": "CHZZK DL",
  "description": "Chzzk Video Downloader",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:electron": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.chzzk-dl.app",
    "productName": "CHZZK & SOOP DL",
    "files": [
      "main.js",
      "server.js",
      "ytdlp-manager.js",
      "public/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "axios": "^1.16.1",
    "express": "^4.22.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^36.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^9.0.10"
  }
}
